+
+void MelonDsDs::PixelBuffer::CopyScaled(const uint32_t* source, uvec2 sourceSize, uvec2 destination, uvec2 destinationSize) noexcept {
+    ZoneScopedN(TracyFunction);
+    if (destinationSize.x == 0 || destinationSize.y == 0)
+        return;
+    // Simple nearest-neighbor scaling (skip destination pixels outside the framebuffer)
+    for (unsigned destY = 0; destY < destinationSize.y; destY++) {
+        const unsigned dstY = destination.y + destY;
+        if (dstY >= size.y)
+            continue;
+        for (unsigned destX = 0; destX < destinationSize.x; destX++) {
+            const unsigned dstX = destination.x + destX;
+            if (dstX >= size.x)
+                continue;
+            // Map destination pixel to source pixel
+            unsigned srcX = (destX * sourceSize.x) / destinationSize.x;
+            unsigned srcY = (destY * sourceSize.y) / destinationSize.y;
+
+            // Clamp to source bounds
+            srcX = std::min(srcX, sourceSize.x - 1);
+            srcY = std::min(srcY, sourceSize.y - 1);
+
+            uint32_t pixel = source[srcY * sourceSize.x + srcX];
+            this->operator[](uvec2(dstX, dstY)) = pixel;
+        }
+    }
+}
