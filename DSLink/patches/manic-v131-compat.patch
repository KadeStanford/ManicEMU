+void MelonDsDs::CoreState::UpdateWfcConnectionStatus(melonDS::NDS& nds) noexcept {
+    ZoneScopedN(TracyFunction);
+
+    // Track the last WFC status to detect changes
+    static int lastWfcStatus = -1;
+
+    // Get the current WFC status directly from WifiAP
+    // 0=disconnected 1=authenticated 2=associated
+    int currentWfcStatus = nds.Wifi.GetWfcStatus();
+
+    // Only update if status has changed
+    if (lastWfcStatus != currentWfcStatus) {
+        // Convert integer status to string for retro_variable
+        char statusBuffer[16];
+        snprintf(statusBuffer, sizeof(statusBuffer), "%d", currentWfcStatus);
+
+        // Set the variable for frontend access
+        retro::set_variable("melonds_wfc_status", statusBuffer);
+
+        // Optional: Log the status change for debugging
+        const char* statusText = "";
+        switch (currentWfcStatus) {
+            case 0: statusText = "Disconnected"; break;
+            case 1: statusText = "Authenticated"; break;
+            case 2: statusText = "Associated"; break;
+            default: statusText = "Invalid"; break;
+        }
+
+        retro::debug("WFC status changed: {} -> {} ({})",
+                    lastWfcStatus, currentWfcStatus, statusText);
+
+        // Update the last known status
+        lastWfcStatus = currentWfcStatus;
+    }
+}
